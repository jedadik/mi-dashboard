# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Wompi Configuration
VITE_WOMPI_CHECKOUT_URL=https://checkout.wompi.co/l/VPOS_xxxxx
VITE_WOMPI_URL_MENSUAL=https://checkout.wompi.co/l/VPOS_xxxxx_monthly
VITE_WOMPI_URL_ANUAL=https://checkout.wompi.co/l/VPOS_xxxxx_annual

# App URL (optional, defaults to window.location.origin)
VITE_APP_URL=http://localhost:5173

# Supabase Function Secrets (configured in Supabase Dashboard)
# WOMPI_EVENTS_SECRET=your-wompi-events-secret
# WOMPI_MONTHLY_LINK_ID=your-wompi-monthly-link-id
# WOMPI_ANNUAL_LINK_ID=your-wompi-annual-link-id
